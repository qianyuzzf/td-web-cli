{
  "name": "td-web-cli",
  "version": "0.1.37",
  "description": "A CLI tool for efficiency",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "td-web-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "setting.json"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,json,md}\" \"tests/**/*.js\" \"docs/**/*.md\" release.js package.json setting.json README.md",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,json,md}\" \"tests/**/*.js\" \"docs/**/*.md\" release.js package.json setting.json README.md",
    "release": "node ./release.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "td-web-cli",
    "cli",
    "i18n",
    "image",
    "tools",
    "extractEntry",
    "json2excel",
    "excel2json",
    "jsonMerge",
    "compressImage",
    "getHolidayTime"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@inquirer/prompts": "^8.2.0",
    "@vue/compiler-sfc": "^3.5.30",
    "axios": "^1.13.3",
    "commander": "^14.0.2",
    "minimatch": "^10.2.4",
    "node-html-parser": "^7.1.0",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/commander": "^2.12.0",
    "@types/node": "^25.0.10",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
